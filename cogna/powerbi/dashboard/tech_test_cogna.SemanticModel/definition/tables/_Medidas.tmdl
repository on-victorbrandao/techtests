			      "</div>" &
			    "</div>" &
			  "</div>" &
			  "<div class='cogna-panel-card'>" &
			    "<div class='cogna-panel-header'>" &
			      "<div><div class='cogna-panel-title'><svg class='cogna-card-subicon' viewBox='0 0 24 24'><path d='M12 2.25a9.75 9.75 0 100 19.5 9.75 9.75 0 000-19.5zM8.25 12a3.75 3.75 0 117.5 0 3.75 3.75 0 01-7.5 0z'/></svg> Q5 — Fricção e Escalada para Retenção</div><div class='cogna-panel-desc'>Velocidade de transição e acúmulo de contatos antes da formalização do cancelamento</div></div>" &
			      "<span class='cogna-tag cogna-tag-amber'>Escalada Rápida no Mesmo Turno</span>" &
