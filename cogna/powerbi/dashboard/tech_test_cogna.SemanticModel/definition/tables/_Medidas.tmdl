	measure #09_Flag_Cobertura_Amostral_Minima =
			
			
			var _contatosRespondidos = [#01_Contatos_Pesquisa_Respondida]
			
			return
			    IF ( _contatosRespondidos >= 30, 1, 0 )
		formatString: @
		displayFolder: 02. Satisfação e pesquisa
		lineageTag: 12edabe9-de91-4079-9954-dd01a383bdc3

	measure #10_Guardrail_Cobertura_Amostral =
			
			
			var _contatosRespondidos = [#01_Contatos_Pesquisa_Respondida]
			var _taxaResposta = [#02_Taxa_Resposta_Pesquisa]
			
			return
			    IF (
			        ISBLANK ( _contatosRespondidos ) || _contatosRespondidos = 0,
			        "Sem respostas válidas no recorte",
			        IF (
			            _contatosRespondidos < 30,
			            "Atenção: baixa cobertura amostral (n = " & FORMAT ( _contatosRespondidos, "#,0" ) & " | " & FORMAT ( _taxaResposta, "0.00%" ) & ")",
			            "Amostra adequada (n = " & FORMAT ( _contatosRespondidos, "#,0" ) & " | " & FORMAT ( _taxaResposta, "0.00%" ) & ")"
			        )
			    )
		formatString: @
		displayFolder: 02. Satisfação e pesquisa
		lineageTag: 72ec1d90-8d66-4805-8ebe-aab3098f2851

