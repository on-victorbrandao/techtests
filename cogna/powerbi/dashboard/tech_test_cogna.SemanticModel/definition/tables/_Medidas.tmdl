			"</div>"
			
			// JavaScript
			var _js = 
			"<script>
			  function switchTab(num) {
			    document.querySelectorAll('.cogna-panel').forEach(function(p) { p.style.display = 'none'; });
			    document.querySelectorAll('.cogna-nav-item').forEach(function(i) {
			      i.style.background = 'transparent';
			      i.style.color = '#737791';
			      i.style.fontWeight = '500';
			    });
			    var target = document.querySelector('.panel-' + num);
			    var nav = document.querySelector('.nav-' + num);
			    if(target) target.style.display = 'block';
			    if(nav) {
			      nav.style.background = '#5219A1';
			      nav.style.color = '#FFFFFF';
			      nav.style.fontWeight = '600';
			    }
			  }
			  document.addEventListener('DOMContentLoaded', function() {
			    switchTab(1);
			    for(var i = 1; i <= 6; i++) {
			      (function(n) {
			        var btn = document.querySelector('.nav-' + n);
			        if(btn) {
			          btn.addEventListener('click', function(e) {
			            e.preventDefault();
			            switchTab(n);
			          });
			        }
			      })(i);
			    }
			  });
			</script>"
			
			return
			_css &
			"<input type='radio' name='cogna-tabs' id='tab-1' checked>" &
			"<input type='radio' name='cogna-tabs' id='tab-2'>" &
			"<input type='radio' name='cogna-tabs' id='tab-3'>" &
			"<input type='radio' name='cogna-tabs' id='tab-4'>" &
