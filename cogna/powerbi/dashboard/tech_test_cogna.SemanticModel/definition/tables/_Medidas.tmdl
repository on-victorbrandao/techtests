			  _sidebar &
			  "<div class='cogna-main'>" &
			    _topbar &
			    "<div class='cogna-content-scroll'>" &
			      _kpi_cards &
			      _panel_executivo &
			      _panel_jornada &
			      _panel_motivos &
			      _panel_retencao &
			      _panel_satisfacao &
			      _panel_agentes &
			    "</div>" &
			  "</div>" &
			"</div>" &
			_js
			
