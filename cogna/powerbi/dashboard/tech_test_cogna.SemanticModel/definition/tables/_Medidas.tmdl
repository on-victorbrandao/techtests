			      "<tbody>" &
			        "<tr><td><b>Suporte Financeiro / Boleto</b></td><td>428</td><td><b>3,82</b></td><td>83</td><td>19,4%</td><td>Menor satisfação devido ao atrito intrínseco de cobrança</td></tr>" &
