			        "<tr><td><b>Dúvidas Acadêmicas / AVA</b></td><td>512</td><td><b>4,52</b></td><td>24</td><td>4,7%</td><td>Atendimento resolutivo com boa percepção</td></tr>" &
			        "<tr><td><b>Consulta de Notas e Calendário</b></td><td>344</td><td><b>4,61</b></td><td>13</td><td>3,8%</td><td>Autoatendimento simples com alta satisfação</td></tr>" &
