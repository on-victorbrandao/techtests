			      "<thead><tr><th>Canal</th><th>Total Contatos</th><th>Pesquisas Respondidas</th><th>Taxa de Resposta</th><th>Nota Média CSAT</th><th>Notas Ruins (1-2)</th><th>% Notas Ruins</th><th>Guardrail Amostral</th></tr></thead>" &
			      "<tbody>" &
			        "<tr><td><b>Vídeo Chamada</b></td><td>1.499</td><td>768</td><td>51,2%</td><td><b>4,70</b></td><td>20</td><td>2,6%</td><td><span class='cogna-badge-pill-mint'>Robusto</span></td></tr>" &
			        "<tr><td><b>Call Center</b></td><td>1.499</td><td>661</td><td>44,1%</td><td><b>4,56</b></td><td>48</td><td>7,3%</td><td><span class='cogna-badge-pill-mint'>Robusto</span></td></tr>" &
			        "<tr><td><b>WhatsApp</b></td><td>1.499</td><td>492</td><td>32,8%</td><td><b>3,89</b></td><td>84</td><td>17,1%</td><td><span class='cogna-badge-pill-amber'>Moderado (84 detratores)</span></td></tr>" &
			        "<tr style='background:#FFF1F2; font-weight:600;'><td style='color:#EF4444;'><b>Totem Presencial</b></td><td>1.494</td><td>24</td><td>1,6%</td><td style='color:#EF4444;'><b>2,96</b></td><td>9</td><td style='color:#EF4444;'>37,5%</td><td><span class='cogna-badge-pill-amber'>Alerta: n=24 baixo</span></td></tr>" &
			      "</tbody>" &
			    "</table>" &
			  "</div>" &
			  "<div class='cogna-panel-card'>" &
			    "<div class='cogna-panel-header'>" &
			      "<div><div class='cogna-panel-title'><svg class='cogna-card-subicon' viewBox='0 0 24 24'><path d='M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z'/></svg> Q7 — Perfil dos Alunos Detratores (Notas Ruins 1 e 2)</div><div class='cogna-panel-desc'>Segmentação demográfica e temporal dos 182 contatos com notas ruins registradas</div></div>" &
			    "</div>" &
			    "<div class='cogna-grid-3'>" &
			      "<div class='cogna-subcard'>" &
			        "<div class='cogna-subcard-title'>Modalidade e Tipo de Aluno</div>" &
			        "<div class='cogna-subcard-val'>68,1% das notas ruins</div>" &
			        "<div class='cogna-subcard-sub'>124 das 182 notas ruins vieram de calouros. Presencial Campus teve 13,2% de notas ruins vs 8,4% em EAD.</div>" &
