			    "<div class='cogna-grid-2' style='margin-bottom:16px;'>" &
			      "<div class='cogna-subcard' style='border-left: 4px solid #5219A1;'>" &
			        "<div class='cogna-subcard-title'>Visão A — Omnichannel (Jornada Ampla)</div>" &
			        "<div class='cogna-subcard-val'>374 Recontatos (6,24%)</div>" &
			        "<div class='cogna-subcard-sub'>Aluno recontatou em qualquer um dos 4 canais no mesmo dia. Agentes com maior volume: AG-008 (200), AG-004 (192) e AG-001 (185). Agente com maior taxa percentual: AG-012 (98,8% em 84 atendimentos).</div>" &
			      "</div>" &
			      "<div class='cogna-subcard' style='border-left: 4px solid #7433DA;'>" &
