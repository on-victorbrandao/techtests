	measure #21_Media_Contatos_Previos_Fila_Retencao =
			
			
			var _eventosComHistoricoPrevio =
			    FILTER (
			        CALCULATETABLE (
			            fato_jornada,
			            fato_contato[canal] = "call_center",
			            fato_contato[eh_retencao_fila] = TRUE ()
			        ),
			        fato_jornada[ordem_contato_aluno] > 1
			    )
			
			return
			    AVERAGEX (
			        _eventosComHistoricoPrevio,
			        fato_jornada[ordem_contato_aluno] - 1
			    )
