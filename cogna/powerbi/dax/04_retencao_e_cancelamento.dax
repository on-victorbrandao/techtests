-- Display Folder: 04. Retenção e cancelamento | Format String: 0.00%
#10_%_Pedidos_Cancelamento_Retencao = 

var _totalCancelamentos = [#09_Pedidos_Cancelamento]
var _baseRetencao = [#03_Contatos_Assunto_Retencao]

return
    DIVIDE ( _totalCancelamentos, _baseRetencao, BLANK () )

