-- Display Folder: 04. Retenção e cancelamento | Format String: #,0
#17_Pedidos_Cancelamento_CC_Com_Outro_Canal_Anterior = 

var _eventosCancelamentoCallCenter =
    CALCULATETABLE (
        SUMMARIZE (
            fato_contato,
            fato_contato[contato_id],
            fato_contato[aluno_hash],
            fato_contato[data_hora_contato]
        ),
        fato_contato[canal] = "call_center",
        fato_contato[desfecho_retencao] = "pedido_cancelamento"
    )
var _eventosComOutroCanalAnterior =
    FILTER (
        _eventosCancelamentoCallCenter,
        var _alunoHash = fato_contato[aluno_hash]
        var _dataHoraContato = fato_contato[data_hora_contato]

return
            CALCULATE (
                COUNTROWS ( fato_contato ),
                ALL ( fato_contato ),
                fato_contato[aluno_hash] = _alunoHash,
                fato_contato[data_hora_contato] < _dataHoraContato,
                fato_contato[canal] <> "call_center"
            ) > 0
    )
return
    COUNTROWS ( _eventosComOutroCanalAnterior )

-- Display Folder: 04. Retenção e cancelamento | Format String: 0.00%
#18_%_Pedidos_Cancelamento_CC_Com_Outro_Canal_Anterior = 

var _cancelamentosComOutroCanal = [#17_Pedidos_Cancelamento_CC_Com_Outro_Canal_Anterior]
var _totalCancelamentosCallCenter =
    CALCULATE (
        [#09_Pedidos_Cancelamento],
        fato_contato[canal] = "call_center"
    )

return
    DIVIDE ( _cancelamentosComOutroCanal, _totalCancelamentosCallCenter, BLANK () )

-- Display Folder: 04. Retenção e cancelamento | Format String: #,0.00
#19_Contatos_Fila_Retencao_Com_Outro_Canal_Anterior = 

var _eventosFilaRetencao =
    CALCULATETABLE (
        SUMMARIZE (
            fato_contato,
            fato_contato[contato_id],
            fato_contato[aluno_hash],
            fato_contato[data_hora_contato]
        ),
        fato_contato[canal] = "call_center",
        fato_contato[eh_retencao_fila] = TRUE ()
    )
var _eventosComOutroCanalAnterior =
    FILTER (
        _eventosFilaRetencao,
        var _alunoHash = fato_contato[aluno_hash]
        var _dataHoraContato = fato_contato[data_hora_contato]

return
            CALCULATE (
                COUNTROWS ( fato_contato ),
                ALL ( fato_contato ),
                fato_contato[aluno_hash] = _alunoHash,
                fato_contato[data_hora_contato] < _dataHoraContato,
                fato_contato[canal] <> "call_center"
            ) > 0
    )
return
    COUNTROWS ( _eventosComOutroCanalAnterior )

-- Display Folder: 04. Retenção e cancelamento | Format String: #,0.00
#20_%_Fila_Retencao_Com_Outro_Canal_Anterior = 

var _filaComOutroCanal = [#19_Contatos_Fila_Retencao_Com_Outro_Canal_Anterior]
var _totalFilaRetencao = [#01_Contatos_Fila_Retencao]

return
    DIVIDE ( _filaComOutroCanal, _totalFilaRetencao, BLANK () )

-- Display Folder: 04. Retenção e cancelamento | Format String: #,0.00
#21_Media_Contatos_Previos_Fila_Retencao = 

var _eventosComHistoricoPrevio =
    FILTER (
        CALCULATETABLE (
            fato_jornada,
            fato_contato[canal] = "call_center",
            fato_contato[eh_retencao_fila] = TRUE ()
        ),
        fato_jornada[ordem_contato_aluno] > 1
    )

return
    AVERAGEX (
        _eventosComHistoricoPrevio,
        fato_jornada[ordem_contato_aluno] - 1
    )

-- Display Folder: 04. Retenção e cancelamento | Format String: #,0.00
#22_Mediana_Contatos_Previos_Fila_Retencao = 

var _eventosComHistoricoPrevio =
    FILTER (
        CALCULATETABLE (
            fato_jornada,
            fato_contato[canal] = "call_center",
            fato_contato[eh_retencao_fila] = TRUE ()
        ),
        fato_jornada[ordem_contato_aluno] > 1
    )

return
    MEDIANX (
        _eventosComHistoricoPrevio,
        fato_jornada[ordem_contato_aluno] - 1
    )

-- Display Folder: 04. Retenção e cancelamento | Format String: #,0.00
#23_Tempo_Mediano_Desde_Ultimo_Contato_Ate_Retencao_h = 

var _eventosComIntervaloValido =
    FILTER (
        CALCULATETABLE (
            fato_jornada,
            fato_contato[canal] = "call_center",
            fato_contato[eh_retencao_fila] = TRUE ()
        ),
        NOT ISBLANK ( fato_jornada[segundos_desde_anterior] )
    )

return
    MEDIANX (
        _eventosComIntervaloValido,
        DIVIDE ( fato_jornada[segundos_desde_anterior], 3600.0, BLANK () )
    )

