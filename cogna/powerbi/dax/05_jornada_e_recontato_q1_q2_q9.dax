-- Display Folder: 05. Jornada e recontato (Q1, Q2, Q9) | Format String: #,0
#17_Q2_Alunos_Sequencia_Intermediarios_CC_WA_Outro_Canal = 

var _alunosBase = VALUES ( dim_aluno[aluno_hash] )
var _alunosQualificados =
    FILTER (
        _alunosBase,
        var _alunoHash = dim_aluno[aluno_hash]
        var _primeiroContatoCallCenter =
            CALCULATE (
                MIN ( fato_jornada[data_hora_contato] ),
                ALL ( fato_jornada ),
                fato_jornada[aluno_hash] = _alunoHash,
                fato_jornada[canal] = "call_center"
            )
        var _primeiroWhatsAppAposCallCenter =
            IF (
                NOT ISBLANK ( _primeiroContatoCallCenter ),
                CALCULATE (
                    MIN ( fato_jornada[data_hora_contato] ),
                    ALL ( fato_jornada ),
                    fato_jornada[aluno_hash] = _alunoHash,
                    fato_jornada[canal] = "whatsapp",
                    fato_jornada[data_hora_contato] > _primeiroContatoCallCenter
                )
            )
        var _contatosCanalPosterior =
            IF (
                NOT ISBLANK ( _primeiroWhatsAppAposCallCenter ),
                CALCULATE (
                    COUNTROWS ( fato_jornada ),
                    ALL ( fato_jornada ),
                    fato_jornada[aluno_hash] = _alunoHash,
                    fato_jornada[canal] <> "whatsapp",
                    fato_jornada[data_hora_contato] > _primeiroWhatsAppAposCallCenter
                ),
                0
            )

return
            _contatosCanalPosterior > 0
    )
return
    COUNTROWS ( _alunosQualificados )

