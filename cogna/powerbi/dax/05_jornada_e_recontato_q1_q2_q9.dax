-- Display Folder: 05. Jornada e recontato (Q1, Q2, Q9) | Format String: #,0
#09_Q1_Contatos_Call_Center_WhatsApp_24h = 

var _contatosCallCenter =
    CALCULATETABLE (
        SUMMARIZE (
            fato_jornada,
            fato_jornada[contato_id],
            fato_jornada[aluno_hash],
            fato_jornada[data_hora_contato]
        ),
        fato_jornada[canal] = "call_center",
        fato_jornada[flag_teve_wa_posterior] = TRUE ()
    )
var _contatosSeguidosAte24h =
    FILTER (
        _contatosCallCenter,
        var _alunoHash = fato_jornada[aluno_hash]
        var _dataHoraCallCenter = fato_jornada[data_hora_contato]
        var _primeiroWhatsAppAposCallCenter =
            CALCULATE (
                MIN ( fato_jornada[data_hora_contato] ),
                ALL ( fato_jornada ),
                fato_jornada[aluno_hash] = _alunoHash,
                fato_jornada[canal] = "whatsapp",
                fato_jornada[data_hora_contato] > _dataHoraCallCenter
            )

return
            NOT ISBLANK ( _primeiroWhatsAppAposCallCenter )
                && DATEDIFF ( _dataHoraCallCenter, _primeiroWhatsAppAposCallCenter, SECOND ) <= 86400
    )
return
    COUNTROWS ( _contatosSeguidosAte24h )

