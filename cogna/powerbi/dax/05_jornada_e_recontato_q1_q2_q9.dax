-- Display Folder: 05. Jornada e recontato (Q1, Q2, Q9) | Format String: #,0
#01_Q1_Alunos_Call_Center_WhatsApp_Posterior = 

CALCULATE (
    DISTINCTCOUNT ( fato_jornada[aluno_hash] ),
    fato_jornada[canal] = "call_center",
    fato_jornada[flag_teve_wa_posterior] = TRUE ()
)

-- Display Folder: 05. Jornada e recontato (Q1, Q2, Q9) | Format String: 0.00%
#02_Q1_%_Alunos_Call_Center_WhatsApp_Posterior = 

var _alunosComWhatsAppPosterior = [#01_Q1_Alunos_Call_Center_WhatsApp_Posterior]
var _totalAlunosCallCenter =
    CALCULATE (
        DISTINCTCOUNT ( fato_jornada[aluno_hash] ),
        fato_jornada[canal] = "call_center"
    )

return
    DIVIDE ( _alunosComWhatsAppPosterior, _totalAlunosCallCenter, BLANK () )

